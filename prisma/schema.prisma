// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]

  @@map("roles")
}

model User {
  id                       Int           @id @default(autoincrement())
  name                     String
  email                    String        @unique
  nik                      String        @unique
  nip                      String?
  pangkat                  String?
  phone                    String        @unique
  gender                   String
  alamat                   String
  user_type                String?       @default("individu")
  nama_perusahaan          String?
  is_active                Boolean       @default(false)
  password                 String
  activation_token         String?
  activation_token_expires DateTime?
  created_at               DateTime      @default(now())
  updated_at               DateTime      @updatedAt
  role_id                  Int
  role                     Role          @relation(fields: [role_id], references: [id])
  Email_log                Email_log[]
  Order                    Order[]
  Transaction              Transaction[]
  hasils                   Hasil[]       @relation("AnalisHasils")
  verifikasi_hasils        Hasil[]       @relation("VerifikatorHasils")
  persetujuan_hasils       Hasil[]       @relation("KepalaHasils")
  Pemohonan                Pemohonan[]

  @@map("users")
}

model Email_log {
  id         Int      @id @default(autoincrement())
  user_id    Int
  email_type String
  status     String // PENDING, SENT, FAILED
  error      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("email_log")
}

model Category {
  id         Int      @id @default(autoincrement())
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  Sampel     Sampel[]

  @@map("categorys")
}

model Sampel {
  id                Int                 @id @default(autoincrement())
  category_id       Int
  parameter         String
  price_sell        Float
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt
  category          Category            @relation(fields: [category_id], references: [id], onDelete: Cascade)
  Order             Order[]
  TransactionDetail TransactionDetail[]
  hasils            Hasil[]
  PemohonanItem     PemohonanItem[]

  @@map("sampels")
}

model Order {
  id         Int      @id @default(autoincrement())
  user_id    Int
  sampel_id  Int
  qty        Int
  price      Float
  status     Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  sampel     Sampel   @relation(fields: [sampel_id], references: [id], onDelete: Cascade)

  @@map("orders")
}

model Hasil {
  id                  Int          @id @default(autoincrement())
  nomor_laporan       String?
  transaction_id      Int?
  user_id             Int          // Analis / Pemeriksa
  verifikator_id      Int?
  kepala_id           Int?
  sampel_id           Int
  qty                 Int
  price               Float
  hasil               String
  metode              String
  satuan              String?
  kode_sampel         String?
  kadar_maksimal      String?
  tujuan_permenkes    String?      // e.g. "PERMENKES RI NO. 2 Tahun 2023"
  status_verifikasi   String       @default("DRAFT") // DRAFT, MENUNGGU_VERIFIKASI, REVISI_ANALIS, DIVERIFIKASI, DISETUJUI
  catatan_revisi      String?      @db.Text
  status              Boolean      @default(false)
  tanggal_pengerjaan  DateTime?
  tanggal_verifikasi  DateTime?
  tanggal_persetujuan DateTime?
  created_at          DateTime     @default(now())
  updated_at          DateTime     @updatedAt

  user                User         @relation("AnalisHasils", fields: [user_id], references: [id], onDelete: Cascade)
  verifikator         User?        @relation("VerifikatorHasils", fields: [verifikator_id], references: [id], onDelete: SetNull)
  kepala              User?        @relation("KepalaHasils", fields: [kepala_id], references: [id], onDelete: SetNull)
  sampel              Sampel       @relation(fields: [sampel_id], references: [id], onDelete: Cascade)
  transaction         Transaction? @relation(fields: [transaction_id], references: [id], onDelete: SetNull)

  @@map("hasil")
}

model Transaction {
  id                  Int                 @id @default(autoincrement())
  user_id             Int
  invoice             String
  cash                Float
  change              Float
  discount            Float?
  grand_total         Float
  no_fa               String?
  qris                String?
  payment_proof       String?
  created_at          DateTime            @default(now())
  user                User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transaction_details TransactionDetail[]
  hasils              Hasil[]

  @@map("transactions")
}

model TransactionDetail {
  id             Int         @id @default(autoincrement())
  transaction_id Int
  sampel_id      Int
  qty            Int
  price          Float
  status_bayar   Boolean     @default(false)
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt
  transaction    Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)
  sampel         Sampel      @relation(fields: [sampel_id], references: [id], onDelete: Cascade)
  JadwalPengambilan JadwalPengambilan[]

  @@map("transaction_details")
}

model Pemohonan {
  id                    Int       @id @default(autoincrement())
  user_id               Int
  jenis                 String    // SURAT_PENAWARAN or PEMESANAN
  status                String    @default("PENDING") // PENDING, APPROVED, CANCELLED, EXPIRED
  tanggal_pengajuan     DateTime  @default(now())
  tanggal_expired       DateTime? // For SURAT_PENAWARAN: 7 days from creation
  tanggal_action        DateTime?
  catatan               String?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  user                  User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  items                 PemohonanItem[]

  @@map("pemohonans")
}

model PemohonanItem {
  id            Int       @id @default(autoincrement())
  pemohonan_id  Int
  sampel_id     Int
  qty           Int
  price         Float
  created_at    DateTime  @default(now())
  pemohonan     Pemohonan @relation(fields: [pemohonan_id], references: [id], onDelete: Cascade)
  sampel        Sampel    @relation(fields: [sampel_id], references: [id], onDelete: Cascade)

  @@map("pemohonan_items")
}

model JadwalPengambilan {
  id                      Int       @id @default(autoincrement())
  transaction_detail_id   Int
  tanggal_pengambilan     DateTime
  jam_pengambilan         String
  lokasi                  String
  petugas                 String
  catatan                 String?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt
  transaction_detail      TransactionDetail @relation(fields: [transaction_detail_id], references: [id], onDelete: Cascade)
  berita_acara_id         Int?
  berita_acara            BeritaAcara? @relation(fields: [berita_acara_id], references: [id], onDelete: SetNull)
  
  @@map("jadwal_pengambilan")
}

model BeritaAcara {
  id                         Int               @id @default(autoincrement())
  no_berita_acara            String            @unique
  jenis_sampel               String            // e.g., "Air Bersih"
  nama_sampel                String?           // e.g., "Kran Utama"
  tujuan_pengambilan         String            @db.Text // JSON: ["Pemantauan", "Pengawasan", ...]
  titik_pengambilan          String?
  tanggal_pengambilan        DateTime
  waktu_pengambilan          String?
  tanggal_selesai_estimasi   DateTime?
  jumlah_wadah               String            @db.Text // JSON: { tipe: "Botol", qty: 2, lainnya: "" }
  peralatan_pengambilan      String            @db.Text // JSON list
  peralatan_pengukur         String            @db.Text // JSON list
  peralatan_pendukung        String            @db.Text // JSON list
  peralatan_k3               String            @db.Text // JSON list
  cara_pengambilan           String            @db.Text // JSON list
  pengendalian_mutu          String            @db.Text // JSON list
  pengawet                   String            @db.Text // JSON list
  pengamanan_transportasi    String            @db.Text // JSON list
  hasil_lapangan             String            @db.LongText // JSON with TTD base64
  sidoarjo_date              DateTime          @default(now())
  petugas_pengambil          String            @db.Text // Teks nama petugas: "1. Imam, 2. Cycy"
  pelanggan_saksi            String?           @db.Text
  foto_pengambilan           String?
  foto_pelabelan             String?
  foto_pengemasan            String?
  status                     String            @default("DRAFT") // DRAFT, FINAL
  created_at                 DateTime          @default(now())
  updated_at                 DateTime          @updatedAt

  jadwals                    JadwalPengambilan[]

  @@map("berita_acaras")
}

